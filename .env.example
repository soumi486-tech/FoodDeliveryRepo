# Neon console -> your project -> Connect -> copy the POOLED connection string
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
PORT=3000
# Better Auth: 32+ random chars (openssl rand -base64 32). scaffold.mjs generates one into .env for you.
BETTER_AUTH_SECRET=
# Public URL of the deployed app (required in production). Locally it is inferred from the request.
# BETTER_AUTH_URL=https://your-app.example.com

# Grafana Cloud (OpenTelemetry). Leave OTEL_EXPORTER_OTLP_ENDPOINT unset to disable telemetry.
# Filled in by: node ~/.claude/skills/build-fullstack-Observability-grafana/scripts/set-grafana-env.mjs
# Headers value: Authorization=Basic%20<base64 of "instanceId:token"> (the space MUST be %20 in an env var)
OTEL_SERVICE_NAME=fooddash
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-REGION.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20BASE64
