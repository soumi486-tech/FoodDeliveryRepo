{
  "name": "fooddash",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch-path=server --watch-path=shared server/index.js --dev",
    "build": "vite build",
    "start": "node server/index.js",
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:e2e": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:report": "playwright show-report"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.301.2",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.301.2",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@opentelemetry/sdk-metrics": "^3.1.1",
    "@opentelemetry/sdk-node": "^0.301.2",
    "better-auth": "^1.7.13",
    "express": "^4.21.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@vitejs/plugin-react": "^4.3.4",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "vite": "^5.4.11"
  }
}
