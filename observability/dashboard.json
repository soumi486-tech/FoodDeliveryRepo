{
  "__inputs": [
    {
      "name": "DS_PROM",
      "label": "Prometheus (grafanacloud-*-prom)",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    },
    {
      "name": "DS_LOKI",
      "label": "Loki (grafanacloud-*-logs)",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    },
    {
      "name": "DS_TEMPO",
      "label": "Tempo (grafanacloud-*-traces)",
      "type": "datasource",
      "pluginId": "tempo",
      "pluginName": "Tempo"
    }
  ],
  "title": "FoodDash Overview",
  "uid": "fooddash-overview",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "fooddash",
    "otel"
  ],
  "templating": {
    "list": [
      {
        "name": "level",
        "label": "Log level",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "query": "info,warn,error",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / sec",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(fooddash_http_requests_total[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate (5xx)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(fooddash_http_requests_total{status=~\"5..\"}[$__rate_interval])) / sum(rate(fooddash_http_requests_total[$__rate_interval]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 latency",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\"fooddash_http_request_duration.*_bucket\"}[$__rate_interval])))",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "orders created (range)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase({__name__=~\"fooddash_orders_created(_total)?\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "orders cancelled (range)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase({__name__=~\"fooddash_orders_cancelled(_total)?\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "orders delivered (range)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase({__name__=~\"fooddash_orders_delivered(_total)?\"}[$__range]))",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request rate by route",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (route) (rate(fooddash_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{route}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le) (rate({__name__=~\"fooddash_http_request_duration.*_bucket\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate({__name__=~\"fooddash_http_request_duration.*_bucket\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.5, sum by (le) (rate({__name__=~\"fooddash_http_request_duration.*_bucket\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Responses by status",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(fooddash_http_requests_total[$__rate_interval]))",
          "legendFormat": "{{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Business events per minute",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({__name__=~\"fooddash_orders_created(_total)?\"}[$__rate_interval])) * 60",
          "legendFormat": "orders created",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate({__name__=~\"fooddash_orders_cancelled(_total)?\"}[$__rate_interval])) * 60",
          "legendFormat": "orders cancelled",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        },
        {
          "refId": "C",
          "expr": "sum(rate({__name__=~\"fooddash_orders_delivered(_total)?\"}[$__rate_interval])) * 60",
          "legendFormat": "orders delivered",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        },
        {
          "refId": "D",
          "expr": "sum(rate({__name__=~\"fooddash_order_rejections(_total)?\"}[$__rate_interval])) * 60",
          "legendFormat": "order rejections",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Average order value",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({__name__=~\"fooddash_order_value.*_sum\"}[$__rate_interval])) / sum(rate({__name__=~\"fooddash_order_value.*_count\"}[$__rate_interval]))",
          "legendFormat": "avg",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Process memory (RSS)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max({__name__=~\"fooddash_process_memory_rss.*\"})",
          "legendFormat": "rss",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Event loop delay p99",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROM}"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max({__name__=~\"fooddash_event_loop_delay_p99.*\"})",
          "legendFormat": "p99",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROM}"
          }
        }
      ]
    },
    {
      "id": 14,
      "type": "logs",
      "title": "Application logs",
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
      },
      "gridPos": {
        "x": 12,
        "y": 28,
        "w": 12,
        "h": 8
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"fooddash\"} | detected_level=~\"$level\"",
          "datasource": {
            "type": "loki",
            "uid": "${DS_LOKI}"
          }
        }
      ]
    },
    {
      "id": 15,
      "type": "table",
      "title": "Recent traces",
      "datasource": {
        "type": "tempo",
        "uid": "${DS_TEMPO}"
      },
      "gridPos": {
        "x": 0,
        "y": 36,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceqlSearch",
          "limit": 20,
          "datasource": {
            "type": "tempo",
            "uid": "${DS_TEMPO}"
          },
          "filters": [
            {
              "id": "svc",
              "tag": "service.name",
              "operator": "=",
              "scope": "resource",
              "value": [
                "fooddash"
              ]
            }
          ]
        }
      ]
    }
  ]
}
